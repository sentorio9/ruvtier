# Public Vite variables. Safe to expose to the browser.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Non-obvious admin route prefix. Must start with / and should not be /admin.
VITE_ADMIN_ROUTE="/change-this-private-admin-route"

# Supabase Edge Function secrets. Set with `supabase secrets set ...`; do not
# expose these in Vite client env or commit real values.
SUPABASE_SERVICE_ROLE_KEY="set-in-supabase-secrets-only"
ADMIN_ALLOWED_ORIGINS="https://ruvtier.com,https://www.ruvtier.com"
ADMIN_COOKIE_SAMESITE="None"
SITE_URL="https://ruvtier.com"
PUBLIC_SITE_URL="https://ruvtier.com"
LOVABLE_API_KEY="set-in-supabase-secrets-only"
LOVABLE_SEND_URL=""

# Future Shopify integration placeholders. Shopify is not authoritative yet.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_ACCESS_TOKEN="set-in-supabase-secrets-only"
SHOPIFY_WEBHOOK_SECRET="set-in-supabase-secrets-only"
